root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.py]
indent_size = 4

[*.sh]
indent_size = 4

# El código original y las dependencias se dejan como están.
[{Old,vendor}/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_size = unset
max_line_length = unset
